# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: comma-separated list of origins allowed to call the API
# cross-origin (e.g. "https://app.example.com,https://admin.example.com").
# Leave unset to deny all cross-origin requests — the SPA calling its own
# same-origin API always works regardless of this setting.
ALLOWED_ORIGINS=""

# --- Persistent database (Phase 3 target — not yet wired in) ---
# See docs/DATABASE-MIGRATION.md. The schema (src/db/schema.ts) and initial
# migration (drizzle/) exist and are ready; server.ts still runs entirely on
# in-memory arrays until this is set AND the routes are switched over to it.
# Any Postgres works — Render's managed Postgres add-on (matches this app's
# current deploy target), Neon, and Supabase all have a free tier.
DATABASE_URL=""

# --- Office 365 / Microsoft Entra ID (Phase 3 target — not yet wired in) ---
# See docs/PROTOTYPE-AUDIT.md, "Target integration: Office 365 / Microsoft
# Entra ID" for what each of these becomes once auth (#1), directory sync
# (#2), and Graph email (#3) land. Unused today — the app still runs on the
# X-User-Id mock-auth header without them. Once the Entra sign-in code lands,
# it should fail fast on startup if any of these required ones are missing,
# rather than silently falling back to header trust.
#
# Entra ID App Registration: Tenant ID, Client ID, and a client secret or
# certificate path — from the app registration's Overview/Certificates & secrets.
TENANT_ID=""
CLIENT_ID=""
CLIENT_SECRET=""
# Space-separated Graph scopes. Start minimal; add Mail.Send / User.Read.All /
# Calendars.ReadWrite only as each Graph integration (#2/#3/#4) actually lands.
GRAPH_SCOPES="openid profile email User.Read"
# OAuth redirect URI(s) registered on the App Registration, matching APP_URL.
OAUTH_REDIRECT_URI=""
